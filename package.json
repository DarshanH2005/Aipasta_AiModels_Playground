{
  "name": "aipasta",
  "version": "1.0.0",
  "description": "AI Pasta monorepo",
  "scripts": {
    "start": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "start:backend": "cd aipasta-backend && npm start",
    "start:frontend": "cd aipasta-frontend/my-app && npm start",
    "dev:backend": "cd aipasta-backend && npm run dev",
    "dev:frontend": "cd aipasta-frontend/my-app && npm run dev",
    "install:all": "npm install && cd aipasta-backend && npm install && cd ../aipasta-frontend/my-app && npm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
